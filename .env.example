# Environment Variables — Mandtech Backend
# Copy this to .env and fill in your values

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (Railway/Supabase/Render format)
DATABASE_URL=postgresql://user:password@host:5432/mandtech

# ── Auth ──────────────────────────────────────────────────────
# Strong random secret for signing JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_random_32_char_secret

# ── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Seeding ───────────────────────────────────────────────────
# Set to "true" on first run to insert seed data
SEED_DB=false

# ── CORS extra origins (comma-separated) ─────────────────────
# Add any additional frontend URLs here
EXTRA_ORIGINS=
